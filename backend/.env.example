# Copy this file to .env and fill in values before starting the server.

# Directory where uploaded videos are saved (relative to backend/)
UPLOAD_DIR=./uploads

# Maximum allowed upload size in MB
MAX_UPLOAD_SIZE_MB=200

# --- Upload basic validation (optional; prefix UPLOAD_) ---
# 仅基础门槛：可读、分辨率、时长。不会因竖屏/关键点质量直接拒绝上传。
# UPLOAD_MIN_SHORT_SIDE_PX=240
# UPLOAD_MIN_DURATION_SEC=0.4
# UPLOAD_MAX_DURATION_SEC=300

# --- Pose runtime (optional; prefix POSE_) ---
# 默认模型改为 full（可选 lite/full/heavy）
# POSE_MODEL_VARIANT=full
# Server default should stay CPU for stability in cloud/headless runtime.
# Set to 1 only when GPU runtime dependencies are present and verified.
# MEDIAPIPE_USE_GPU=0
# POSE_MIN_POSE_DETECTION_CONFIDENCE=0.35
# POSE_MIN_POSE_PRESENCE_CONFIDENCE=0.30
# POSE_MIN_TRACKING_CONFIDENCE=0.35
# POSE_MAX_INTERP_GAP_FRAMES=5
# POSE_SMOOTHING_ALPHA=0.55

# --- QC / valid_segment (optional; prefix QC_) ---
# 代码默认约 2–120s、允许竖屏 w/h>=0.65。若 job.json 仍出现 [3.0,5.0]：请删掉下面两行或改为 120，并重启 uvicorn。
# QC_MIN_DURATION_SEC=2
# QC_MAX_DURATION_SEC=120
# QC_MIN_FPS=15
# QC_MAX_FPS=120
# 竖屏录像 w/h 约 0.56–0.75，可临时放宽（侧向跑姿算法仍以横屏侧拍为理想）：
# QC_MIN_LANDSCAPE_ASPECT_RATIO=0.65
# QC_MIN_LANDMARK_VISIBILITY=0.5
# QC_MAX_LOW_VISIBILITY_RATIO=0.35
# QC_MISSING_VISIBILITY_CUTOFF=0.1
# QC_MAX_MISSING_RATIO=0.2
# QC_IN_FRAME_MARGIN=0.02
# QC_FULL_BODY_MIN_VISIBILITY=0.45
# QC_MIN_SEGMENT_DURATION_MS=600
# QC_MIN_SEGMENT_FRAMES=8
# QC_MAX_QC_GAP_FRAMES=10

# MediaPipe pose model (required for real analysis):
#   python scripts/download_model.py
# File examples:
#   backend/models/pose_landmarker_full.task   (default)
#   backend/models/pose_landmarker_lite.task
#   backend/models/pose_landmarker_heavy.task

# --- DeepSeek AI Analysis (optional; prefix DEEPSEEK_) ---
# AI analysis layer for intelligent interpretation of sprint video results.
# Without these, AI analysis will fallback to rule-based interpretation.
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT=60
