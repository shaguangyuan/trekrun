:root,
page {
  --s-bg: #f2f2f7;
  --s-card: #ffffff;
  --s-text: #111111;
  --s-subtext: #6e6e73;
  --s-muted: #8e8e93;
  --s-line: #e5e5ea;
  --s-primary: #0a84ff;
  --s-primary-pressed: #0071e3;
  --s-success: #34c759;
  --s-warning: #ff9f0a;
  --s-danger: #ff3b30;
  --s-radius-card: 18rpx;
  --s-radius-btn: 14rpx;
}

.s-page {
  min-height: 100vh;
  background: var(--s-bg);
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.s-hero {
  margin: 8rpx 8rpx 20rpx;
}

.s-title {
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 700;
  color: var(--s-text);
}

.s-subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--s-subtext);
}

.s-card {
  background: var(--s-card);
  border-radius: var(--s-radius-card);
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.s-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--s-text);
  margin-bottom: 14rpx;
}

.s-note {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--s-muted);
}

.s-input {
  height: 86rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--s-line);
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--s-text);
  background: #fff;
  box-sizing: border-box;
}

.s-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--s-line);
  padding: 0 20rpx;
  font-size: 24rpx;
  color: var(--s-subtext);
  margin: 0 12rpx 12rpx 0;
}

.s-btn-primary,
.s-btn-secondary {
  height: 96rpx;
  border-radius: var(--s-radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.s-btn-primary {
  background: var(--s-primary);
  color: #fff;
}

.s-btn-primary-pressed {
  background: var(--s-primary-pressed);
}

.s-btn-primary-disabled {
  background: #b6d8ff;
  color: #f7fbff;
}

.s-btn-secondary {
  background: #fff;
  color: var(--s-primary);
  border: 1rpx solid #c8defb;
}

.s-btn-secondary-pressed {
  background: #f5f9ff;
}

.s-empty {
  background: #fff;
  border-radius: var(--s-radius-card);
  padding: 52rpx 36rpx;
  text-align: center;
}

.s-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--s-text);
}

.s-empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--s-subtext);
}

.s-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.s-tag-success {
  background: #e8f9ef;
  color: #128449;
}

.s-tag-warning {
  background: #fff4e6;
  color: #9f6300;
}

.s-tag-danger {
  background: #ffeceb;
  color: #b3261e;
}
