@import "/pages/sprint/common/ui.wxss";

.page {
  padding-bottom: 36rpx;
}

.loading-inline {
  padding: 40rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #888;
}

.error-text {
  color: #666;
}

.athlete-bar {
  margin-bottom: 16rpx;
}

.athlete-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.athlete-label {
  font-size: 30rpx;
  color: #111;
  font-weight: 700;
}

.athlete-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6e6e73;
}

.chart-section {
  margin-bottom: 16rpx;
}

.chart-title {
  font-size: 27rpx;
  color: #1f1f1f;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 200rpx;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar-score {
  font-size: 22rpx;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.bar-track {
  width: 48rpx;
  height: 140rpx;
  background: #eff2f6;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  background: #0a84ff;
  border-radius: 8rpx 8rpx 0 0;
}

.bar-date {
  font-size: 20rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f1f1f;
  padding: 2rpx 8rpx 12rpx;
}

.record-list {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f1f5;
}

.record-item-press {
  background: #f8f8fb;
}

.record-item:last-child {
  border-bottom: none;
}

.record-date {
  font-size: 28rpx;
  color: #333;
}

.record-right {
  display: flex;
  align-items: baseline;
}

.record-score {
  font-size: 38rpx;
  font-weight: 700;
  color: #0a84ff;
}

.record-unit {
  font-size: 22rpx;
  color: #888;
}

.record-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}

.empty-btn {
  margin-top: 18rpx;
}
