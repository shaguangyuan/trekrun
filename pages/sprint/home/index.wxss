.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #f5f6f7;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-top: 12rpx;
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #0052d9;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.btn-secondary {
  width: 100%;
  height: 96rpx;
  background: #fff;
  color: #0052d9;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 2rpx solid #0052d9;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tip {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}
